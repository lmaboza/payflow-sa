{
  "name": "EmployeeNotification",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "title": "Business"
    },
    "employee_id": {
      "type": "string",
      "title": "Employee"
    },
    "type": {
      "type": "string",
      "enum": [
        "payslip_available",
        "salary_processed",
        "leave_approved",
        "leave_rejected",
        "tax_document",
        "claim_status",
        "query_response",
        "detail_change"
      ],
      "title": "Type"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "link": {
      "type": "string",
      "title": "Link"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "title": "Read"
    }
  },
  "required": [
    "business_id",
    "employee_id",
    "type",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.employee_id": "{{user.data.employee_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.employee_id": "{{user.data.employee_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}